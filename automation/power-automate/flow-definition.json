{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_an_agent_calls_the_flow": {
      "type": "Request",
      "kind": "PowerVirtualAgents",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    }
  },
  "actions": {
    "Run_Office_Script": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
          "connectionName": "shared_excelonlinebusiness",
          "operationId": "RunScriptProV2"
        },
        "parameters": {
          "source": "me",
          "drive": "PLACEHOLDER_DRIVE_ID",
          "file": "PLACEHOLDER_WORKBOOK_ID",
          "scriptId": "PLACEHOLDER_SCRIPT_ID",
          "ScriptParameters": {}
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Create_board_html": {
      "runAfter": {
        "Run_Office_Script": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "CreateFile"
        },
        "parameters": {
          "dataset": "https://PLACEHOLDER_TENANT.sharepoint.com/sites/PLACEHOLDER_SITE",
          "folderPath": "/Shared Documents/Consumer",
          "name": "consumer-martech.html",
          "body": "@body('Run_Office_Script')?['result']"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Respond_to_the_agent": {
      "runAfter": {
        "Create_board_html": [
          "Succeeded"
        ]
      },
      "type": "Response",
      "kind": "PowerVirtualAgents",
      "inputs": {
        "statusCode": 200,
        "body": {
          "board_url": "@{outputs('Create_board_html')?['body/{Link}']}"
        },
        "schema": {
          "type": "object",
          "properties": {
            "board_url": {
              "type": "string",
              "title": "board_url",
              "x-ms-content-hint": "TEXT"
            }
          }
        }
      }
    }
  },
  "outputs": {}
}